%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#f2f2f2','primaryTextColor':'#1a1a1a','primaryBorderColor':'#2c2c2c','lineColor':'#2c2c2c','fontFamily':'Arial, Helvetica, sans-serif','fontSize':'15px'}}}%%
flowchart TD
    classDef inicio fill:#8b1e1e,stroke:#2c2c2c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef admin fill:#2c2c2c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef publico fill:#5c5c5c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef sistema fill:#f2f2f2,stroke:#2c2c2c,stroke-width:1.5px,color:#1a1a1a
    classDef decision fill:#ffffff,stroke:#8b1e1e,stroke-width:2px,color:#1a1a1a
    classDef adminAsync fill:#2c2c2c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef publicoAsync fill:#5c5c5c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef sistemaAsync fill:#f2f2f2,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#1a1a1a
    classDef pendiente fill:#ffffff,stroke:#999999,stroke-width:1.5px,stroke-dasharray: 3 3,color:#555555
    Start([Acceso al módulo Gestión documental]):::inicio --> Access{¿Quién accede?}:::decision
    Access -->|Vista pública| Denied[Sin acceso — solo el personal administrativo ve y modifica documentos]:::publico
    Access -->|Vista administrativa| Explorer[Explorador de archivos propio del deportista]:::admin

    Explorer --> DocType{Tipo de documento}:::decision
    DocType --> Ins[Formulario de inscripción]:::sistema
    DocType --> ID[Documento de identidad / del acudiente]:::sistema
    DocType --> Photo[Fotografía]:::sistema
    DocType --> Consent[Consentimientos]:::sistema
    DocType --> Certs[Certificados / actas de ascenso]:::sistema
    DocType --> CompDocs[Documentación de competencias]:::sistema
    DocType --> Prep[Preparación física: documento de referencia archivado, sin módulo estructurado]:::pendiente

    Ins --> Upload[Subir archivo en formato PDF o Word]:::admin
    ID --> Upload
    Photo --> Upload
    Consent --> Upload
    Certs --> Upload
    CompDocs --> Upload

    Upload --> Native[Indicador de carga nativo del navegador — no requiere JavaScript asíncrono dedicado]:::sistema
    Native --> End([Documento almacenado]):::inicio

    Consent --> ConsentPend[PENDIENTE DE ALDRIN: lista exacta de consentimientos específicos requeridos]:::pendiente
