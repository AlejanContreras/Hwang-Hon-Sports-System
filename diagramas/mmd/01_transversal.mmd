%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#f2f2f2','primaryTextColor':'#1a1a1a','primaryBorderColor':'#2c2c2c','lineColor':'#2c2c2c','fontFamily':'Arial, Helvetica, sans-serif','fontSize':'15px'}}}%%
flowchart TD
    classDef inicio fill:#8b1e1e,stroke:#2c2c2c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef admin fill:#2c2c2c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef publico fill:#5c5c5c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef sistema fill:#f2f2f2,stroke:#2c2c2c,stroke-width:1.5px,color:#1a1a1a
    classDef decision fill:#ffffff,stroke:#8b1e1e,stroke-width:2px,color:#1a1a1a
    classDef adminAsync fill:#2c2c2c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef publicoAsync fill:#5c5c5c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef sistemaAsync fill:#f2f2f2,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#1a1a1a
    classDef pendiente fill:#ffffff,stroke:#999999,stroke-width:1.5px,stroke-dasharray: 3 3,color:#555555
    Start([Usuario autenticado en el sistema]):::inicio --> Ambito{¿Ámbito?}:::decision

    subgraph ADM[Vista Administrativa]
        Ambito -->|Administrativo| AdminChoice[Elegir vista: Documentos o Deportivo/Estadística]:::admin
        AdminChoice --> AdminList[Sistema muestra listado completo de deportistas registrados]:::sistema
        AdminList --> AdminSearch["⚡ Buscador con autocompletado — filtra mientras se escribe (compartido con módulos 1, 3 y 4)"]:::adminAsync
        AdminSearch --> AdminSelect[Administrativo selecciona un deportista]:::admin
        AdminSelect --> AdminModule[Navega informalmente al módulo que le compete: deportistas, asistencia, pagos, documentos, etc.]:::admin
        AdminModule --> AdminNote[Sin permisos granulares por módulo — Aldrin decide informalmente si distribuye el acceso]:::pendiente
    end

    subgraph PUB[Vista Pública]
        Ambito -->|Público| PubChoice[Elegir vista: Documentos o Deportivo/Estadística]:::publico
        PubChoice --> PubFilter[Sistema filtra directo a los datos propios del deportista o tutor que ingresó — sin listado]:::sistema
        PubFilter --> PubView[Deportista/acudiente consulta o edita solo peso y discapacidad/condición de salud]:::publico
    end

    AdminModule --> Header[Header / Sidebar reutilizables en todos los módulos]:::sistema
    PubView --> Header
    Header --> End([Fin de navegación])
