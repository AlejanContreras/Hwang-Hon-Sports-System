%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#f2f2f2','primaryTextColor':'#1a1a1a','primaryBorderColor':'#2c2c2c','lineColor':'#2c2c2c','fontFamily':'Arial, Helvetica, sans-serif','fontSize':'15px'}}}%%
flowchart TD
    classDef inicio fill:#8b1e1e,stroke:#2c2c2c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef admin fill:#2c2c2c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef publico fill:#5c5c5c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef sistema fill:#f2f2f2,stroke:#2c2c2c,stroke-width:1.5px,color:#1a1a1a
    classDef decision fill:#ffffff,stroke:#8b1e1e,stroke-width:2px,color:#1a1a1a
    classDef adminAsync fill:#2c2c2c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef publicoAsync fill:#5c5c5c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef sistemaAsync fill:#f2f2f2,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#1a1a1a
    classDef pendiente fill:#ffffff,stroke:#999999,stroke-width:1.5px,stroke-dasharray: 3 3,color:#555555
    Start([Acceso al módulo Estadísticas y rendimiento]):::inicio --> Select1[Seleccionar primer deportista]:::admin
    Select1 --> Agg[Sistema agrega datos ya registrados en otros módulos: competencias, ascensos, historial deportivo — no captura datos nuevos]:::sistema
    Agg --> View[Vista analítica individual: evolución, fortalezas/aspectos por mejorar como notas descriptivas — sin recomendaciones tácticas automáticas]:::sistema
    View --> CompareQ{¿Comparar con otro deportista?}:::decision

    CompareQ -->|No| End1([Fin de la consulta]):::inicio
    CompareQ -->|Sí| Select2["⚡ Seleccionar segundo deportista — buscador con autocompletado compartido"]:::adminAsync
    Select2 --> LoadCol2["⚡ Sus datos se cargan en la columna derecha sin recargar la página ni perder la vista del primero"]:::adminAsync
    LoadCol2 --> SplitView[Vista dividida: comparación en paralelo — exclusiva del ámbito administrativo]:::admin
    SplitView --> End2([Fin de la comparación]):::inicio

    Agg --> QualEval[PENDIENTE DE ALDRIN: evaluación cualitativa periódica — preguntas base, escala 1-5 / 1-10]:::pendiente
