%%{init: {'theme':'base', 'themeVariables': {'primaryColor':'#f2f2f2','primaryTextColor':'#1a1a1a','primaryBorderColor':'#2c2c2c','lineColor':'#2c2c2c','fontFamily':'Arial, Helvetica, sans-serif','fontSize':'15px'}}}%%
flowchart TD
    classDef inicio fill:#8b1e1e,stroke:#2c2c2c,stroke-width:2px,color:#ffffff,font-weight:bold
    classDef admin fill:#2c2c2c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef publico fill:#5c5c5c,stroke:#8b1e1e,stroke-width:2px,color:#ffffff
    classDef sistema fill:#f2f2f2,stroke:#2c2c2c,stroke-width:1.5px,color:#1a1a1a
    classDef decision fill:#ffffff,stroke:#8b1e1e,stroke-width:2px,color:#1a1a1a
    classDef adminAsync fill:#2c2c2c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef publicoAsync fill:#5c5c5c,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#ffffff
    classDef sistemaAsync fill:#f2f2f2,stroke:#8b1e1e,stroke-width:3px,stroke-dasharray: 5 5,color:#1a1a1a
    classDef pendiente fill:#ffffff,stroke:#999999,stroke-width:1.5px,stroke-dasharray: 3 3,color:#555555
    Start([Acceso al módulo Gestión de deportistas]):::inicio --> Entry{¿Cómo se registra el deportista?}:::decision

    Entry -->|Formulario virtual| VForm[Se completa el formulario: datos personales, información deportiva, acudiente/representante, documentación relacionada]:::admin
    Entry -->|Transcripción manual| Manual[Administrativo transcribe el formulario físico existente]:::admin
    Entry -->|Carga masiva| CSVUpload[Administrativo sube la plantilla Excel exportada a CSV]:::admin

    CSVUpload --> CSVValidate["⚡ Sistema valida fila por fila, sin recargar la página"]:::sistemaAsync
    CSVValidate --> CSVErrors{¿Se detectan errores?}:::decision
    CSVErrors -->|Sí| CSVShow["⚡ Sistema muestra los errores fila por fila antes de confirmar"]:::sistemaAsync
    CSVShow --> CSVUpload
    CSVErrors -->|No| CSVConfirm[Administrativo confirma la importación]:::admin

    VForm --> Save[Sistema guarda el registro del deportista]:::sistema
    Manual --> Save
    CSVConfirm --> Save

    Save --> AutoCalc[PROPUESTA: recálculo automático de edad y categoría con el tiempo]:::pendiente

    Save --> Search["⚡ Buscador de deportistas con autocompletado — compartido con módulos 3 y 4"]:::adminAsync
    Search --> EditRule{¿Quién edita el dato?}:::decision
    EditRule -->|Vista administrativa| EditAll[Puede editar cualquier dato del deportista]:::admin
    EditRule -->|Vista pública| EditLimited[Deportista/acudiente solo edita peso y discapacidad/condición de salud]:::publico

    EditAll --> End([Ficha del deportista actualizada]):::inicio
    EditLimited --> End
